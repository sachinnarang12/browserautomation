# === Required ===
AUTOMATEPORTAL_LICENSE_SECRET=change-me-to-a-long-random-string
NOVA_ACT_API_KEY=your-nova-act-api-key-here

# === Edition (standard or commercial) ===
AUTOMATEPORTAL_EDITION=standard

# === Optional ===
