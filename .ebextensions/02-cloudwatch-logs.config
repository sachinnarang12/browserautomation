files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/eb-engine.log",
                  "log_group_name": "/aws/elasticbeanstalk/ai-question-app-production",
                  "log_stream_name": "{instance_id}/eb-engine.log"
                },
                {
                  "file_path": "/var/log/eb-hooks.log",
                  "log_group_name": "/aws/elasticbeanstalk/ai-question-app-production",
                  "log_stream_name": "{instance_id}/eb-hooks.log"
                },
                {
                  "file_path": "/var/log/httpd/access_log",
                  "log_group_name": "/aws/elasticbeanstalk/ai-question-app-production",
                  "log_stream_name": "{instance_id}/httpd-access.log"
                },
                {
                  "file_path": "/var/log/httpd/error_log",
                  "log_group_name": "/aws/elasticbeanstalk/ai-question-app-production",
                  "log_stream_name": "{instance_id}/httpd-error.log"
                }
              ]
            }
          }
        }
      }

commands:
  01_restart_cloudwatch_agent:
    command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s"